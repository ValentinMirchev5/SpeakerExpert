@page
@model SpeakerExpert.Web.Pages.Shop.IndexModel
@{
    ViewData["Title"] = "Shop";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="m-0">Shop Speakers</h1>
    </div>

    @if (TempData["CartError"] != null)
    {
        <div class="alert alert-danger mb-3">@TempData["CartError"]</div>
    }

    <form method="get" class="mb-4">
        <div class="row g-2 align-items-end">

            <div class="col-md-4">
                <label class="form-label">Search</label>
                <input class="form-control" name="Search" value="@Model.Search"
                       placeholder="Search by name or description..." />
            </div>

            <div class="col-md-2">
                <label class="form-label">Type</label>
                <input class="form-control" name="Type" value="@Model.Type"
                       placeholder="e.g. Car, Portable" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Min €</label>
                <input class="form-control" type="number" name="MinPrice" value="@Model.MinPrice" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Max €</label>
                <input class="form-control" type="number" name="MaxPrice" value="@Model.MaxPrice" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Sort</label>
                <select class="form-select" name="Sort">
                    <option value="name_asc">Name (A-Z)</option>
                    <option value="name_desc">Name (Z-A)</option>
                    <option value="price_asc">Price (Low-High)</option>
                    <option value="price_desc">Price (High-Low)</option>
                </select>
            </div>

        </div>

        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-primary flex-grow-1" type="submit">Apply filters</button>

            <!-- clears querystring by going to /Shop with no params -->
            <a class="btn btn-outline-secondary" asp-page="/Shop/Index">Clear</a>
        </div>

    </form>

    @if (Model.Items.Count == 0)
    {
        <div class="alert alert-secondary">No speakers found.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var sp in Model.Items)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <img class="card-img-top"
                             style="height:180px; object-fit:cover;"
                             src="~/images/speakers/@Model.GetImageFile(sp)" />

                        <div class="card-body">
                            <h5 class="card-title">@sp.Name</h5>
                            <div class="text-muted">@sp.Type Speaker</div>
                            <p class="mt-2">@sp.Description</p>
                            <div class="fw-bold">€@sp.Price</div>
                            <div class="small text-muted">In stock: @sp.Stock</div>

                        </div>

                        <div class="card-footer d-flex gap-2">
                            <a class="btn btn-outline-primary w-100"
                               asp-page="/Shop/Details"
                               asp-route-id="@sp.Id">
                                Details
                            </a>

                            <form method="post" asp-page-handler="AddToCart" class="w-100">
                                <input type="hidden" name="id" value="@sp.Id" />
                                <button class="btn btn-primary w-100">Add to Cart</button>
                            </form>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>
