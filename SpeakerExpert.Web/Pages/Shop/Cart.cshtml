@page
@model SpeakerExpert.Web.Pages.Shop.CartModel
@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="m-0">Shopping Cart</h1>
        <a class="btn btn-outline-primary" asp-page="/Shop/Index">Back to Shop</a>
    </div>

    @if (Model.Cart.Count == 0)
    {
        <div class="alert alert-secondary">Your cart is empty.</div>
    }
    else
    {
        <div class="card p-3">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Speaker</th>
                            <th style="width:120px;">Price</th>
                            <th style="width:120px;">Qty</th>
                            <th style="width:140px;">Subtotal</th>
                            <th style="width:120px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Cart)
                        {
                            <tr>
                                <td>@item.SpeakerName</td>
                                <td>€@item.UnitPrice</td>
                                <td>
                                    <span class="badge bg-light text-dark px-3 py-2">
                                        @item.Quantity
                                    </span>

                                </td>
                                <td>€@(item.UnitPrice* item.Quantity)</td>
                                <td>
                                    <form method="post" asp-page-handler="Remove">
                                        <input type="hidden" name="speakerId" value="@item.SpeakerId" />
                                        <button class="btn btn-danger btn-sm">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3">
                <form method="post" asp-page-handler="Clear">
                    <button class="btn btn-outline-primary">Clear Cart</button>
                </form>

                <div class="fs-5 fw-bold">
                    Total: €@Model.Total
                </div>
            </div>

            <div class="mt-3">
                <a class="btn btn-primary w-100" asp-page="/Shop/Checkout">Checkout</a>
            </div>
        </div>
    }
</div>

