@page
@model SpeakerExpert.Web.Pages.Shop.DetailsModel
@{
    ViewData["Title"] = "Speaker Details";
}

<div class="container mt-4">
    <a class="btn btn-outline-primary mb-3" asp-page="/Shop/Index">Back</a>

    <div class="card p-3">
        <div class="row g-3">
            <div class="col-md-5">
                <img class="w-100 rounded" style="height:280px; object-fit:cover;"
                     src="~/images/speakers/@Model.Img" />
            </div>
            <div class="col-md-7">
                <h2>@Model.Speaker!.Name</h2>
                <div class="text-muted">@Model.Speaker.Type Speaker</div>

                <p class="mt-3">@Model.Speaker.Description</p>

                <div class="fs-4 fw-bold">€@Model.Speaker.Price</div>
                <div class="small text-muted">Stock: @Model.Speaker.Stock</div>

                <hr class="my-4" />

                <h4 class="mb-3">Reviews</h4>

                @if (Model.Reviews == null || Model.Reviews.Count == 0)
                {
                    <div class="text-muted mb-3">No reviews yet. Be the first to review!</div>
                }
                else
                {
                    foreach (var r in Model.Reviews)
                    {
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="fw-bold">
                                            @(string.IsNullOrWhiteSpace(r.Title) ? "Review" : r.Title)
                                        </div>
                                        <div class="text-muted small">
                                            @r.UserEmail • @r.CreatedAt.ToLocalTime()
                                        </div>
                                    </div>
                                    <span class="badge bg-secondary">@r.Rating / 5</span>
                                </div>

                                <p class="mb-0 mt-2">@r.Body</p>
                            </div>
                        </div>
                    }
                }

                <h5 class="mb-2 mt-4">Write a review</h5>

                @if (!User.Identity.IsAuthenticated)
                {
                    <div class="alert alert-info">
                        Please <a asp-page="/Account/Login">log in</a> to post a review.
                    </div>
                }
                else
                {
                    <form method="post" asp-page-handler="AddReview" class="mt-2">
                        <input type="hidden" name="id" value="@Model.Speaker!.Id" />

                        <div asp-validation-summary="All" class="text-danger mb-2"></div>

                        <div class="mb-2">
                            <label class="form-label">Rating (1–5)</label>
                            <input asp-for="NewReview.Rating" class="form-control" type="number" min="1" max="5" />
                            <span asp-validation-for="NewReview.Rating" class="text-danger"></span>
                        </div>

                        <div class="mb-2">
                            <label class="form-label">Title (optional)</label>
                            <input asp-for="NewReview.Title" class="form-control" />
                            <span asp-validation-for="NewReview.Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Review</label>
                            <textarea asp-for="NewReview.Body" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="NewReview.Body" class="text-danger"></span>
                        </div>

                        <button class="btn btn-primary">Post review</button>
                    </form>
                }

                <div class="mt-4">
                    <a class="btn btn-outline-primary" asp-page="/Shop/Index">Back to Shop</a>
                </div>

            </div>
        </div>
    </div>
    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }

</div>

