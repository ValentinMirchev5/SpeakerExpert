@page
@model SpeakerExpert.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="container mt-4" style="max-width:520px;">
    <div class="card p-4 shadow-sm">
        <h2 class="mb-3">Create Account</h2>

        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="alert alert-danger">@Model.Message</div>
        }

        <form method="post">
            <div class="mb-2">
                <label class="form-label">Email</label>
                <input class="form-control" asp-for="Email" />
            </div>

            <div class="mb-2">
                <label class="form-label">Password</label>
                <input class="form-control" asp-for="Password" type="password" />
            </div>

            <div class="mb-3">
                <label class="form-label">Account Type</label>
                <select class="form-select" asp-for="Role">
                    <option value="Customer">Customer</option>
                    <option value="Employee">Employee</option>
                </select>
                <div class="small text-muted mt-1">
                    For now you can create either type. Later we can lock employee creation.
                </div>
            </div>

            <button class="btn btn-primary w-100">Register</button>
        </form>

        <div class="mt-3 text-center">
            <a asp-page="/Account/Login">Already have an account? Login</a>
        </div>
    </div>
</div>
