@page
@model SpeakerExpert.Web.Pages.Shop.IndexModel
@{
    ViewData["Title"] = "Shop Speakers";
}

<div class="container mt-3">

    <h2 class="mb-3">Shop Speakers</h2>

    <div class="mb-3">
        <a asp-page="/Shop/Cart" class="btn btn-outline-primary btn-sm">
            View Cart
        </a>
    </div>

    <!-- Search + Type filter -->
    <form method="get" class="row g-3 mb-4">
        <div class="col-md-6">
            <label class="form-label">Search</label>
            <input type="text"
                   name="SearchTerm"
                   value="@Model.SearchTerm"
                   class="form-control"
                   placeholder="Search by name or description" />
        </div>

        <div class="col-md-4">
            <label class="form-label">Speaker Type</label>
            <select name="TypeFilter" class="form-select">
                <option value="">All Types</option>
                <option value="Car" selected="@(Model.TypeFilter == "Car")">Car</option>
                <option value="Portable" selected="@(Model.TypeFilter == "Portable")">Portable</option>
                <option value="PC" selected="@(Model.TypeFilter == "PC")">PC</option>
            </select>
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-success w-100">Apply</button>
        </div>
    </form>

    <!-- Product cards -->
    <div class="row row-cols-1 row-cols-md-3 g-4">

        @if (Model.Speakers.Count == 0)
        {
            <div class="col">
                <div class="alert alert-info">No speakers found.</div>
            </div>
        }
        else
        {
            foreach (var s in Model.Speakers)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <img class="card-img-top"
                             style="object-fit:cover;height:180px;"
                             src="@Url.Content("~/images/speakers/" + (string.IsNullOrEmpty(s.ImageFileName) ? "placeholder.png" : s.ImageFileName))" />


                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@s.Name</h5>
                            <h6 class="card-subtitle mb-2 text-muted">@s.Type Speaker</h6>
                            <p class="card-text flex-grow-1">
                                @s.Description
                            </p>
                            <p class="fw-bold mb-2">@s.Price.ToString("C")</p>

                            <div class="mt-auto">
                                <a asp-page="/Shop/Details"
                                   asp-route-id="@s.Id"
                                   class="btn btn-outline-secondary btn-sm me-2">
                                    Details
                                </a>

                                <form method="post" asp-page-handler="AddToCart" style="display:inline;">
                                    <input type="hidden" name="speakerId" value="@s.Id" />
                                    <input type="hidden" name="typeFilter" value="@Model.TypeFilter" />
                                    <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                                    <button type="submit" class="btn btn-primary btn-sm">
                                        Add to Cart
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }

        }
    </div>
</div>

