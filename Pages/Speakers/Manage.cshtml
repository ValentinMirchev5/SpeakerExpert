@page
@model SpeakerExpert.Web.Pages.Speakers.ManageModel
@{
    ViewData["Title"] = "Manage Speakers (Employee View)";
}

<h2>SpeakerExpert – Employee Management</h2>

<!-- Filter Buttons -->
<div style="margin-bottom:20px;">
    <a href="/Speakers/Manage" style="margin-right:10px;">All</a>
    <a href="/Speakers/Manage?TypeFilter=Car" style="margin-right:10px;">Car Speakers</a>
    <a href="/Speakers/Manage?TypeFilter=Portable" style="margin-right:10px;">Portable Speakers</a>
    <a href="/Speakers/Manage?TypeFilter=PC">PC Speakers</a>
</div>

<!-- Add New Speaker -->
<h3>Add New Speaker</h3>
<form method="post" asp-page-handler="Add" style="margin-bottom:20px;">
    <label>Name:</label><br />
    <input type="text" name="NewSpeaker.Name" required /><br /><br />

    <label>Type (Car / Portable / PC):</label><br />
    <input type="text" name="NewSpeaker.Type" required /><br /><br />

    <label>Description:</label><br />
    <textarea name="NewSpeaker.Description" rows="3"></textarea><br /><br />

    <label>Price:</label><br />
    <input type="number" step="0.01" name="NewSpeaker.Price" required /><br /><br />

    <button type="submit">Add Speaker</button>
</form>

<hr />

<!-- Edit Speaker (only shown when EditSpeaker.Id > 0) -->
@if (Model.EditSpeaker != null && Model.EditSpeaker.Id > 0)
{
    <h3>Edit Speaker (ID: @Model.EditSpeaker.Id)</h3>
    <form method="post" asp-page-handler="Update" style="margin-bottom:20px;">
        <input type="hidden" name="EditSpeaker.Id" value="@Model.EditSpeaker.Id" />

        <label>Name:</label><br />
        <input type="text" name="EditSpeaker.Name" value="@Model.EditSpeaker.Name" /><br /><br />

        <label>Type:</label><br />
        <input type="text" name="EditSpeaker.Type" value="@Model.EditSpeaker.Type" /><br /><br />

        <label>Description:</label><br />
        <textarea name="EditSpeaker.Description" rows="3">@Model.EditSpeaker.Description</textarea><br /><br />

        <label>Price:</label><br />
        <input type="number" step="0.01" name="EditSpeaker.Price" value="@Model.EditSpeaker.Price" /><br /><br />

        <button type="submit">Save Changes</button>
    </form>

    <hr />
}

<!-- List of Speakers -->
<h3>All Speakers</h3>
<table border="1" cellpadding="6" style="border-collapse:collapse;width:100%;">
    <tr style="background-color:#f0f0f0;">
        <th>ID</th>
        <th>Name</th>
        <th>Type</th>
        <th>Description</th>
        <th>Price</th>
        <th>Actions</th>
    </tr>

    @foreach (var s in Model.Speakers)
    {
        <tr>
            <td>@s.Id</td>
            <td>@s.Name</td>
            <td>@s.Type</td>
            <td>@s.Description</td>
            <td>@s.Price.ToString("C")</td>
            <td>
                <!-- Start Edit -->
                <form method="post" asp-page-handler="StartEdit" style="display:inline;">
                    <input type="hidden" name="id" value="@s.Id" />
                    <button type="submit">Edit</button>
                </form>

                <!-- Delete -->
                <form method="post" asp-page-handler="Delete" style="display:inline;">
                    <input type="hidden" name="id" value="@s.Id" />
                    <button type="submit">Delete</button>
                </form>
            </td>
        </tr>
    }
</table>




