@page
@model SpeakerExpert.Web.Pages.Speakers.ManageModel
@{
    ViewData["Title"] = "Manage Speakers (Employee View)";
}

<div class="container mt-3">
    <h2 class="mb-3">SpeakerExpert – Manage Speakers</h2>

    <p>
        <a asp-page="/Speakers/Browse" class="btn btn-outline-secondary btn-sm">
            ← Back to Browse Speakers
        </a>
    </p>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <!-- Add Speaker card -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header">
                    <strong>Add New Speaker</strong>
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="Add" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                        <div class="mb-3">
                            <label asp-for="NewSpeaker.Name" class="form-label"></label>
                            <input asp-for="NewSpeaker.Name" class="form-control" />
                            <span asp-validation-for="NewSpeaker.Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewSpeaker.Type" class="form-label"></label>
                            <input asp-for="NewSpeaker.Type" class="form-control" placeholder="Car / Portable / PC" />
                            <span asp-validation-for="NewSpeaker.Type" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewSpeaker.Description" class="form-label"></label>
                            <textarea asp-for="NewSpeaker.Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="NewSpeaker.Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewSpeaker.Price" class="form-label"></label>
                            <input asp-for="NewSpeaker.Price" class="form-control" />
                            <span asp-validation-for="NewSpeaker.Price" class="text-danger"></span>
                        </div>


                        <div class="mb-3">
                            <label class="form-label">Image (optional)</label>
                            <input type="file" class="form-control" name="UploadImage" />
                            <div class="form-check mt-2">
                                <input asp-for="UseImageForNew" class="form-check-input" id="UseImageForNew" />
                                <label class="form-check-label" asp-for="UseImageForNew">
                                    Upload a custom image for this speaker
                                </label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success">
                            Add Speaker
                        </button>

                    </form>
                </div>
            </div>
        </div>

        <!-- Edit Speaker card -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header">
                    <strong>Edit Speaker</strong>
                </div>
                <div class="card-body">
                    @if (Model.EditSpeaker != null && Model.EditSpeaker.Id > 0)
                    {
                        <form method="post" asp-page-handler="Update" enctype="multipart/form-data">
                            <input type="hidden" asp-for="EditSpeaker.Id" />

                            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                            <div class="mb-3">
                                <label asp-for="EditSpeaker.Name" class="form-label"></label>
                                <input asp-for="EditSpeaker.Name" class="form-control" />
                                <span asp-validation-for="EditSpeaker.Name" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="EditSpeaker.Type" class="form-label"></label>
                                <input asp-for="EditSpeaker.Type" class="form-control" />
                                <span asp-validation-for="EditSpeaker.Type" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="EditSpeaker.Description" class="form-label"></label>
                                <textarea asp-for="EditSpeaker.Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="EditSpeaker.Description" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="EditSpeaker.Price" class="form-label"></label>
                                <input asp-for="EditSpeaker.Price" class="form-control" />
                                <span asp-validation-for="EditSpeaker.Price" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Image</label>
                                <input type="file" class="form-control" name="UploadImage" />

                                @if (!string.IsNullOrEmpty(Model.EditSpeaker.ImageFileName))
                                {
                                    <img src="~/images/speakers/@Model.EditSpeaker.ImageFileName"
                                         class="img-thumbnail mt-2" style="max-width:150px;" />
                                }
                            </div>


                            <button type="submit" class="btn btn-primary">
                                Save Changes
                            </button>

                        </form>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            Select a speaker to edit from the
                            <a asp-page="/Speakers/Browse">Browse Speakers</a> page.
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}




