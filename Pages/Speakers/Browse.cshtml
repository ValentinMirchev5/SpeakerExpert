@page
@model SpeakerExpert.Web.Pages.Speakers.BrowseModel
@{
    ViewData["Title"] = "Browse Speakers";
}

<div class="container mt-3">
    <h2 class="mb-3">Browse Speakers</h2>

    <div class="mb-3">
        <a asp-page="/Speakers/Manage" class="btn btn-primary btn-sm">Go to Manage Speakers</a>
    </div>

    <!-- Search + Filter + Sort -->
    <form method="get" class="row g-3 mb-4">
        <div class="col-md-4">
            <label class="form-label">Search (name or description)</label>
            <input type="text"
                   name="SearchTerm"
                   value="@Model.SearchTerm"
                   class="form-control"
                   placeholder="e.g. bass, bluetooth..." />
        </div>

        <div class="col-md-3">
            <label class="form-label">Speaker Type</label>
            <select name="TypeFilter" class="form-select">
                <option value="">All Types</option>
                <option value="Car" selected="@(Model.TypeFilter == "Car")">Car</option>
                <option value="Portable" selected="@(Model.TypeFilter == "Portable")">Portable</option>
                <option value="PC" selected="@(Model.TypeFilter == "PC")">PC</option>
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">Sort By</label>
            <select name="SortBy" class="form-select">
                <option value="Name" selected="@(Model.SortBy == "Name")">Name</option>
                <option value="Type" selected="@(Model.SortBy == "Type")">Type</option>
                <option value="Price" selected="@(Model.SortBy == "Price")">Price</option>
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label">Direction</label>
            <select name="SortDirection" class="form-select">
                <option value="asc" selected="@(Model.SortDirection == "asc")">Ascending</option>
                <option value="desc" selected="@(Model.SortDirection == "desc")">Descending</option>
            </select>
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-success">Apply</button>
            <a asp-page="/Speakers/Browse" class="btn btn-outline-secondary ms-2">Clear</a>

        </div>
    </form>

    <!-- Speakers Table -->
    <div class="card">
        <div class="card-header">
            Speakers (@Model.Speakers.Count)
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-light">

                    <tr>
                        <th>ID</th>
                        <th>
                            @* Sort by Name when clicking header *@
                            <a asp-page="/Speakers/Browse"
                               asp-route-SearchTerm="@Model.SearchTerm"
                               asp-route-TypeFilter="@Model.TypeFilter"
                               asp-route-SortBy="Name"
                               asp-route-SortDirection="@(Model.SortBy == "Name" && Model.SortDirection == "asc" ? "desc" : "asc")">
                                Name
                                @if (Model.SortBy == "Name")
                                {
                                    <span>@(Model.SortDirection == "asc" ? "▲" : "▼")</span>
                                }
                            </a>
                        </th>
                        <th>
                            <a asp-page="/Speakers/Browse"
                               asp-route-SearchTerm="@Model.SearchTerm"
                               asp-route-TypeFilter="@Model.TypeFilter"
                               asp-route-SortBy="Type"
                               asp-route-SortDirection="@(Model.SortBy == "Type" && Model.SortDirection == "asc" ? "desc" : "asc")">
                                Type
                                @if (Model.SortBy == "Type")
                                {
                                    <span>@(Model.SortDirection == "asc" ? "▲" : "▼")</span>
                                }
                            </a>
                        </th>
                        <th>Description</th>
                        <th>
                            <a asp-page="/Speakers/Browse"
                               asp-route-SearchTerm="@Model.SearchTerm"
                               asp-route-TypeFilter="@Model.TypeFilter"
                               asp-route-SortBy="Price"
                               asp-route-SortDirection="@(Model.SortBy == "Price" && Model.SortDirection == "asc" ? "desc" : "asc")">
                                Price
                                @if (Model.SortBy == "Price")
                                {
                                    <span>@(Model.SortDirection == "asc" ? "▲" : "▼")</span>
                                }
                            </a>
                        </th>
                        <th style="width:160px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Speakers.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-3">No speakers found.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var s in Model.Speakers)
                        {
                            <tr>
                                <td>@s.Id</td>
                                <td>@s.Name</td>
                                <td>@s.Type</td>
                                <td>@s.Description</td>
                                <td>@s.Price.ToString("C")</td>
                                <td>
                                    <a asp-page="/Speakers/Manage"
                                       asp-route-id="@s.Id"
                                       class="btn btn-sm btn-primary me-1">
                                        Edit
                                    </a>

                                    <form method="post"
                                          asp-page-handler="Delete"
                                          style="display:inline;">
                                        <input type="hidden" name="id" value="@s.Id" />
                                        <input type="hidden" name="typeFilter" value="@Model.TypeFilter" />
                                        <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                                        <input type="hidden" name="sortBy" value="@Model.SortBy" />
                                        <input type="hidden" name="sortDirection" value="@Model.SortDirection" />
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Delete this speaker?');">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


